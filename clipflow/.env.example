# App
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Paths
DATA_DIR=data
DB_PATH=data/clipflow.db
DOWNLOAD_DIR=data/downloads
CLIPS_DIR=data/clips
LOG_DIR=data/logs

# Gemini
GEMINI_API_KEY=

# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard auth
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Public URL of the dashboard (optional; used for links in Telegram digests)
DASHBOARD_PUBLIC_URL=

# Uploaders (YouTube / Instagram)
YOUTUBE_CLIENT_SECRETS_PATH=
# YouTube upload settings (unaudited API projects are force-locked to private by YouTube)
YOUTUBE_PRIVACY=public
YOUTUBE_CATEGORY_ID=24
YOUTUBE_DAILY_UPLOAD_CAP=90
YOUTUBE_API_AUDITED=false
# OAuth token files (chmod 700, never commit)
SECRETS_DIR=data/secrets
# Instagram (Meta app with Facebook Login; tokens are stored in SECRETS_DIR by ig-connect, never here)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
INSTAGRAM_DAILY_CAP=20
INSTAGRAM_SHARE_TO_FEED=true

# Posting (mode per platform: api | manual | auto = api if YOUTUBE_API_AUDITED else manual;
# slots per platform in TIMEZONE, ';' between platforms)
POST_MODE=youtube:auto,instagram:api,tiktok:manual,x:manual
POSTING_SLOTS=youtube:10:30,14:30,19:30,22:00;instagram:11:00,18:00,21:30;tiktok:12:00,17:30,20:30,23:00
SLOT_JITTER_MIN=12
MIN_GAP_MIN=90
PLAN_DAYS_AHEAD=2
MANUAL_REMIND_HOURS=12
MANUAL_EXPIRE_HOURS=48

# Content Rewards submission (posts must be submitted within 30 min; posts only go live inside the window)
SUBMIT_WINDOW=09:00-23:30
SUBMIT_DEADLINE_MIN=30
SUBMIT_REMIND_MIN=15

# Performance tracking (YOUTUBE_API_KEY is optional: public stats for manual-mode YouTube posts)
YOUTUBE_API_KEY=
TRACK_DAYS=30
AUTO_TYPICAL_VIEWS=true
VIEW_MILESTONES=10000,50000,100000,500000

# Mac: keep the machine awake (caffeinate) while the scheduler runs
KEEP_AWAKE=true

# Campaign scout fallback (Apify)
APIFY_TOKEN=
APIFY_ACTOR=fayoussef~whop-clipping-campaigns-scraper

# Campaign scoring (comma lists; MY_NICHES e.g. podcast,streamer,football,gaming)
MY_PLATFORMS=youtube,instagram
MY_NICHES=
MY_CAMPAIGN_TYPES=clipping
TYPICAL_VIEWS=3000
MIN_CPM=0.3
MIN_BUDGET_LEFT=500
MIN_DAYS_LEFT=3

# Limits
MAX_DISK_GB=20

# Downloader (YTDLP_COOKIES_FILE = optional Netscape cookies.txt for when YouTube asks to sign in)
MAX_SOURCE_MINUTES=240
MAX_SOURCE_GB=4
YTDLP_COOKIES_FILE=
DOWNLOAD_MAX_HEIGHT=1080

# Disk cleanup (days to keep files after use; warn when the volume is this % full)
KEEP_SOURCE_DAYS=3
KEEP_CLIP_DAYS=7
DISK_WARN_PCT=85

# Transcription (backend local = faster-whisper on CPU; openai = API, needs OPENAI_API_KEY; whisper-1 gives word timestamps)
TRANSCRIBE_BACKEND=local
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
TRANSCRIPTS_DIR=data/transcripts
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Moment picking (Gemini via GEMINI_API_KEY above; prices are $ per 1M tokens, for estimates only)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PRICE_IN=0.30
GEMINI_PRICE_OUT=2.50
AI_MONTHLY_BUDGET_USD=5
MOMENTS_PER_SOURCE=8
MOMENTS_WINDOW_MIN=45

# Clip rendering (layout auto = crop on faces, else blurred-background pad; font file lives in app/assets/fonts)
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_CRF=21
RENDER_LAYOUT=auto
RENDER_PER_RUN=4
CAPTION_FONT=Anton
CAPTION_WORDS_PER_LINE=3

# Compliance (max clip length per platform in seconds; max rendered file size)
PLATFORM_MAX_SEC=youtube:180,instagram:90,tiktok:600,x:140
MAX_CLIP_MB=200
